{
  "uid": "order-tracker",
  "title": "Order Tracker \u2014 Homework 4",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "homework4"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Order lookup requests by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (order_lookup_requests_total)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "5xx requests in last 2 minutes",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(order_lookup_requests_total{http_response_status_code=~\"5..\"}[2m])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request rate by route and status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_response_status_code) (rate(order_lookup_requests_total[2m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Order lookup logs \u2014 expand for trace_id and open Tempo",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"order-tracker\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Recent request traces",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"order-tracker\" }",
          "limit": 20
        }
      ]
    }
  ]
}
